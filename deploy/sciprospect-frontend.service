[Unit]
Description=SciProspect web app (Next.js)
After=network-online.target sciprospect-backend.service
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/researcher_tool/frontend
Environment=NODE_ENV=production
Environment=FASTAPI_ORIGIN=http://127.0.0.1:8000
Environment=PORT=3000
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
